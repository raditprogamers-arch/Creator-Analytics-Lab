# Neon PostgreSQL Connection URL (Pooled recommended for application queries)
# Format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-123456.aws.neon.tech/neondb?sslmode=require

# Optional Unpooled Direct URL (used for migrations and administrative tasks)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample-123456.aws.neon.tech/neondb?sslmode=require

# Application Environment & Base URL
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# YouTube Data & Analytics API (Google Cloud Console OAuth 2.0 Client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok Creator API (TikTok for Developers)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram Graph API (Meta for Developers)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=


